# =======================================================
# 1. Base de données locale (DÉVELOPPEMENT LOCAL ISOLÉ)
# Avec Docker : docker compose up -d
# =======================================================
DATABASE_URL="postgresql://rzpanda:rzpanda_dev_password@localhost:5432/rzpanda_local?schema=public"
DIRECT_URL="postgresql://rzpanda:rzpanda_dev_password@localhost:5432/rzpanda_local?schema=public"

# =======================================================
# 2. Supabase (Pour Auth et Storage)
# Remplacer par vos clés de projet de test/dev Supabase
# =======================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL locale de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

